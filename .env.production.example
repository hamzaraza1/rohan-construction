# Copy to .env.production on the VPS and fill in. Generate passwords with:  openssl rand -base64 32
POSTGRES_SUPERUSER_PASSWORD=
APP_OWNER_PASSWORD=
APP_READONLY_PASSWORD=

# First admin (used by the one-time seed command)
SEED_ADMIN_NAME=Hamza
SEED_ADMIN_USERNAME=hamza
SEED_ADMIN_PASSWORD=

# How Caddy serves the site — see deploy/caddy/Caddyfile
SITE_ADDRESS=:80
# internal  -> self-signed certificate for https://<VPS-IP>
# you@mail  -> Let's Encrypt certificate for a real domain
CADDY_TLS=internal
# Set to true as soon as SITE_ADDRESS uses HTTPS.
COOKIE_SECURE=false
