# --- Database -----------------------------------------------------------------
# Development defaults (match docker-compose.dev.yml). Production uses .env.production.
# Owner role: runs migrations and all writes (writes are additionally checked by
# database triggers to come from an active ADMIN user).
DATABASE_URL="postgresql://rc_owner:devpass@localhost:5432/rohan?schema=public"
# Read-only role: used for every read in the application.
DATABASE_READONLY_URL="postgresql://rc_readonly:devro@localhost:5432/rohan?schema=public"

# --- Files --------------------------------------------------------------------
UPLOAD_DIR="./storage/uploads"

# --- Sessions -----------------------------------------------------------------
# Set to "true" once the site is served over HTTPS (required for real data).
COOKIE_SECURE="false"

# --- First admin (used only by `npm run db:seed`) -------------------------------
SEED_ADMIN_NAME="Hamza"
SEED_ADMIN_USERNAME="hamza"
SEED_ADMIN_PASSWORD="change-this-long-password"
